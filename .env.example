# ─── Aplicacion Spring Boot 
# APP_PORT: puerto del host (deja libre el 8080 para la exposicion publica).
# SERVER_PORT: puerto interno del contenedor.
APP_PORT=8090
SERVER_PORT=8080
DB_URL=jdbc:postgresql://supabase-db:5432/postgres
DB_USER=postgres
DB_PASS=change_me
ADMIN_EMAIL=admin@example.com
SPRING_JPA_SHOW_SQL=false
APP_SEED_ENABLED=false

# ─── Base de datos PostgreSQL (Supabase) 
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ─── Supabase 
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_GATEWAY_PORT=8000
SITE_URL=http://localhost:8090
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

JWT_SECRET=change_me
JWT_EXPIRY=3600
ANON_KEY=change_me
SERVICE_ROLE_KEY=change_me

# Credenciales de acceso a Supabase Studio. Cambialas antes de desplegar en produccion.
STUDIO_USER=admin
STUDIO_PASSWORD=change_me
