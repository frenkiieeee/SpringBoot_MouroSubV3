# ============================================================
# CONFIGURACION MOUROSUB - COPIA ESTE ARCHIVO COMO .env
# Y EJECUTA: ./setup.sh
# ============================================================
# El script setup.sh auto-detectara tu IP LAN y generara
# passwords/secrets unicos automaticamente.
# ============================================================

# Aplicacion Spring Boot
APP_PORT=8090
SERVER_PORT=8080
ADMIN_EMAIL=admin@mourosub.com
APP_SEED_ENABLED=true
SPRING_JPA_SHOW_SQL=false

# Conexion a la base de datos (la app dentro de Docker se conecta al contenedor 'supabase-db').
DB_URL=jdbc:postgresql://supabase-db:5432/postgres
DB_USER=postgres
DB_PASS=POSTGRES_PASSWORD_PLACEHOLDER

# Base de datos PostgreSQL (Supabase)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=POSTGRES_PASSWORD_PLACEHOLDER

# Supabase - PUERTO DEL GATEWAY (nginx) expuesto al host.
# El gateway (nginx) escucha en 8000 dentro del contenedor.
# Cambia el primer numero si el puerto 8000 ya esta en uso.
SUPABASE_GATEWAY_PORT=8000

# Supabase URL publica: el navegador usa esta para conectar a Supabase Auth/Storage.
# IMPORTANTE: esta URL seSobreescribe dinámicamente en el endpoint /api/config
# usando la IP del host desde el que se accede. El valor aqui es solo fallback.
# Para acceso desde OTROS DISPOSITIVOS en la misma red, usa la IP de esta maquina.
# Ejemplo: http://192.168.1.100:8000  (setup.sh lo detecta automaticamente)
SUPABASE_PUBLIC_URL=http://YOUR_LAN_IP:8000

SITE_URL=http://YOUR_LAN_IP:8000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Claves JWT (deben ser identicas en todos los contenedores y en el app).
# IMPORTANTE: genera nuevas claves antes de produccion.
# setup.sh las genera automaticamente.
JWT_SECRET=JWT_SECRET_PLACEHOLDER
JWT_EXPIRY=3600

# Claves Supabase (igual para todos los contenedores).
# setup.sh las genera automaticamente.
ANON_KEY=ANON_KEY_PLACEHOLDER
SERVICE_ROLE_KEY=SERVICE_ROLE_KEY_PLACEHOLDER

# Supabase Studio (Basic Auth del panel de administracion)
STUDIO_USER=admin
STUDIO_PASSWORD=Grupo3
