# Aplicacion Spring Boot
# APP_PORT: puerto publicado en el host.  SERVER_PORT: puerto interno del contenedor.
APP_PORT=8090
SERVER_PORT=8080
ADMIN_EMAIL=admin@mourosub.com
APP_SEED_ENABLED=false
SPRING_JPA_SHOW_SQL=false

# Conexion a la base de datos (la app dentro de Docker se conecta a 'supabase-db').
DB_URL=jdbc:postgresql://supabase-db:5432/postgres
DB_USER=postgres
DB_PASS=change_me

# Base de datos PostgreSQL (Supabase)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Supabase
# SUPABASE_PUBLIC_URL debe usar el mismo puerto que SUPABASE_GATEWAY_PORT.
SUPABASE_GATEWAY_PORT=8019
SUPABASE_PUBLIC_URL=http://localhost:8019
SITE_URL=http://localhost:8090
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Claves JWT (compartidas por GoTrue, PostgREST, Storage y la app Spring Boot).
JWT_SECRET=change_me
JWT_EXPIRY=3600
ANON_KEY=change_me
SERVICE_ROLE_KEY=change_me

# ═══ Supabase Studio (Basic Auth del panel de administracion)
STUDIO_USER=admin
STUDIO_PASSWORD=change_me
